    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE targets t SET status = 'drafting'\nFROM applicants a\nWHERE t.applicant_id = a.id\n  AND t.id IN (SELECT id FROM targets WHERE status = 'email_found' ORDER BY id LIMIT 1 FOR UPDATE SKIP LOCKED)\nRETURNING t.id, t.company, t.email, t.address, t.postcity, t.contact, t.hr_email,\n          a.chat_id, a.skeleton_file, a.email_sample_file;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -1200,
        80
      ],
      "id": "f4670211-410d-433a-95d6-6047ec26e461",
      "name": "Lock drafting",
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "e9f01737-7cc6-4fa4-b6a9-0f69efbff12c",
              "leftValue": "={{ !!$json.id }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -1008,
        80
      ],
      "id": "6a6e97d3-7571-4ef3-bb55-7df66bb87a3c",
      "name": "Has row?"
    },
    {
      "parameters": {
        "command": "=cat \"{{ $json.skeleton_file }}\"; echo \"@@@SEP@@@\"; cat \"{{ $json.email_sample_file }}\""
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -800,
        80
      ],
      "id": "3b40654d-553f-48a7-81a8-94c4cbf2ca6d",
      "name": "Read assets"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const t = $('Lock drafting').item.json;\nconst parts = String($json.stdout || '').split('@@@SEP@@@');\nif (parts.length < 2) throw new Error('Fichiers assets introuvables');\nconst [skeleton, sample] = parts.map(s => s.trim());\nconst map = { '\\\\': '\\\\textbackslash{}', '&': '\\\\&', '%': '\\\\%', '$': '\\\\$', '#': '\\\\#', '_': '\\\\_',\n              '{': '\\\\{', '}': '\\\\}', '~': '\\\\textasciitilde{}', '^': '\\\\textasciicircum{}' };\nconst esc = s => String(s ?? '').replace(/[\\\\&%$#_{}~^]/g, c => map[c]);\nconst attention = t.contact ? `À l'attention de ${t.contact}` : \"À l'attention du service Ressources humaines\";\nconst recipient = [t.company, attention, t.address, t.postcity].filter(Boolean).map(esc).join('\\\\\\\\\\n');\nconst date = new Date().toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });\nconst tex = skeleton.replace('<<RECIPIENT>>', recipient).replace('<<DATE>>', date);\n// email body = sample without the greeting line\nconst body = sample.replace(/^\\s*Madame, Monsieur,\\s*/i, '').trim();\nconst subject = 'Candidature spontanée – Apprentissage DAP Agent administratif et commercial';\nconst b64 = s => Buffer.from(String(s), 'utf8').toString('base64');\nconst caption = `${t.company} → ${[t.email, t.hr_email].filter(Boolean).join(' + ')}\\n${[attention, t.address, t.postcity].filter(Boolean).join('\\n')}\\n\\nObjet : ${subject}`.slice(0, 1000);\nreturn { json: { id: t.id, chat_id: t.chat_id, company: t.company, email: t.email, dir: `/data/jobs/${t.id}`,\n  tex_b64: b64(tex), subject_b64: b64(subject), body_b64: b64(body), caption } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
        80
      ],
      "id": "114c5cd4-df01-48fa-898d-de7315b9d401",
      "name": "Render"
    },
    {
      "parameters": {
        "command": "=mkdir -p {{ $json.dir }} && node -e \"require('fs').writeFileSync(process.argv[1], Buffer.from(process.argv[2], 'base64'))\" {{ $json.dir }}/letter.tex {{ $json.tex_b64 }} && cd {{ $json.dir }} && rm -f letter.pdf && tectonic -X compile letter.tex > compile.log 2>&1; test -f letter.pdf && echo PDF_OK || tail -15 compile.log"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -400,
        80
      ],
      "id": "27179c58-fa33-45ec-a11b-37a799cd16d2",
      "name": "Compile",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "d93f4b25-cb0e-46e3-aa15-f3ef4c6b1622",
              "leftValue": "={{ String($json.stdout || '').includes('PDF_OK') }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -208,
        80
      ],
      "id": "650a562d-209a-4908-a2f4-442539c20d7c",
      "name": "PDF ok?"
    },
    {
      "parameters": {
        "fileSelector": "={{ $('Render').item.json.dir }}/letter.pdf",
        "options": {
          "dataPropertyName": "pdf"
        }
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "2f1f0755-d6d5-43c5-b46b-87d5d6d634c7",
      "name": "Read PDF"
    },
    {
      "parameters": {
        "operation": "sendDocument",
        "chatId": "={{ $('Render').item.json.chat_id }}",
        "binaryData": true,
        "binaryPropertyName": "pdf",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Envoyer",
                    "additionalFields": {
                      "callback_data": "=approve:{{ $('Render').item.json.id }}"
                    }
                  },
                  {
                    "text": "🔄 Refaire",
                    "additionalFields": {
                      "callback_data": "=redo:{{ $('Render').item.json.id }}"
                    }
                  },
                  {
                    "text": "❌ Ignorer",
                    "additionalFields": {
                      "callback_data": "=skip:{{ $('Render').item.json.id }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "caption": "={{ $('Render').item.json.caption }}"
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        208,
