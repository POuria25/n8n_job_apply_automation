      ],
      "id": "c21af85a-9771-4922-8f6d-c149a61eb9b4",
      "name": "Send preview",
      "webhookId": "b55f615d-86fd-469a-bbd2-4937aa5365e5",
      "credentials": {
        "telegramApi": {
          "id": " ",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE targets SET status = 'awaiting_approval',\n  subject = convert_from(decode($1, 'base64'), 'UTF8'),\n  email_body = convert_from(decode($2, 'base64'), 'UTF8'),\n  letter_pdf = $3, error = NULL\nWHERE id = $4 RETURNING id;",
        "options": {
          "queryReplacement": "={{ $('Render').item.json.subject_b64 }},{{ $('Render').item.json.body_b64 }},{{ $('Render').item.json.dir + '/letter.pdf' }},{{ $('Render').item.json.id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        400,
        0
      ],
      "id": "937599e3-2560-49c0-ae06-b1222cad0cb1",
      "name": "Save draft",
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const t = $('Lock drafting').item.json;\nconst e = 'Compilation LaTeX : ' + String($json.stdout || $json.stderr || '').slice(-400);\nreturn { json: { id: t.id, chat_id: t.chat_id, company: t.company,\n  err_b64: Buffer.from(e, 'utf8').toString('base64'),\n  msg: `⚠️ Lettre impossible pour ${t.company} :\\n${e.slice(0, 300)}` } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
