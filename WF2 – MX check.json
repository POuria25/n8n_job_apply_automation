{
  "name": "WF2 – MX check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        -1408,
        80
      ],
      "id": "340abe3f-4170-430b-b85e-040944c6b6d7",
      "name": "Every 2 minutes"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE targets t SET status = 'checking'\nFROM applicants a\nWHERE t.applicant_id = a.id\n  AND t.id IN (SELECT id FROM targets WHERE status = 'new' ORDER BY id LIMIT 10 FOR UPDATE SKIP LOCKED)\nRETURNING t.id, t.company, t.email_domain, a.chat_id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -1200,
        80
      ],
      "id": "180c68d7-9a73-4a9d-9602-6187ba61fedd",
      "name": "Lock new",
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://dns.google/resolve?name={{ $json.email_domain }}&type=MX",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -800,
        80
      ],
      "id": "36b5f84a-a4fb-414e-9d61-28f6fde7c4a4",
      "name": "DNS MX",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const t = $('Lock new').item.json;\nconst mx = ($json.Answer || []).filter(a => a.type === 15);\nconst mx_ok = mx.length > 0 && !mx.every(a => /^0 \\.$/.test(String(a.data).trim()));\nreturn { json: { ...t, mx_ok, status: mx_ok ? 'email_found' : 'no_email' } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
        80
      ],
      "id": "9d98402f-8f3a-4ced-ac3c-260c4e4aa921",
      "name": "Decide"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE targets SET status = $1, mx_ok = $2 WHERE id = $3 RETURNING id, status;",
        "options": {
          "queryReplacement": "={{ $json.status }},{{ $json.mx_ok }},{{ $json.id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -400,
        80
      ],
      "id": "16844d0c-c027-467a-909a-84f6fb2e530a",
      "name": "Save check",
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "806f6994-e899-4ebb-9b99-a1defeeb57c8",
              "leftValue": "={{ $json.status }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "no_email"
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -208,
        80
      ],
      "id": "3b483155-6e45-413d-b480-e173a7e89dab",
      "name": "Bad domain?"
    },
    {
      "parameters": {
        "chatId": "={{ $('Decide').item.json.chat_id }}",
        "text": "=⚠️ {{ $('Decide').item.json.company }} : le domaine {{ $('Decide').item.json.email_domain }} ne reçoit pas d'emails. Vérifie l'adresse et renvoie la ligne corrigée.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
